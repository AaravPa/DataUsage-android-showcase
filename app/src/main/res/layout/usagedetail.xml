<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linearLayoutDtk"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        style="@style/SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/details_title"
        android:textAllCaps="true" />

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvIdealUsage" style="@style/DetailLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/idealusage" />
        <TextView android:id="@+id/tvIdealUsageVal" style="@style/DetailValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvUsageDiff" style="@style/DetailLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/usagediff" />
        <TextView android:id="@+id/tvUsageDiffVal" style="@style/DetailValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout
        android:id="@+id/linearLayout10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvOverageLikely" style="@style/DetailLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/overagelikely" />
        <TextView android:id="@+id/tvOverageLikelyVal" style="@style/DetailValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvProjectedUsage" style="@style/DetailLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/projectedusage" />
        <TextView android:id="@+id/tvProjectedUsageVal" style="@style/DetailValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout
        android:id="@+id/linearLayout5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvUsageToday" style="@style/DetailLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/usagetoday" />
        <TextView android:id="@+id/tvUsageTodayVal" style="@style/DetailValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout
        android:id="@+id/linearLayout6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvUsageThisWeek" style="@style/DetailLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/usagethisweek" />
        <TextView android:id="@+id/tvUsageThisWeekVal" style="@style/DetailValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout
        android:id="@+id/linearLayout7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvBillingPeriod" style="@style/DetailLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/billingperiod" />
        <TextView android:id="@+id/tvBillingPeriodVal" style="@style/DetailValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout
        android:id="@+id/linearLayout8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvNextBillDate" style="@style/DetailLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/nextbilldate" />
        <TextView android:id="@+id/tvNextBillDateVal" style="@style/DetailValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout
        android:id="@+id/linearLayout9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvTodayDate" style="@style/DetailLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/todaydate" />
        <TextView android:id="@+id/todaydateVal" style="@style/DetailValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvReceived" style="@style/DetailLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/received" />
        <TextView android:id="@+id/tvReceivedVal" style="@style/DetailValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <View style="@style/DetailDivider" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvSent" style="@style/DetailLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/sent" />
        <TextView android:id="@+id/tvSentVal" style="@style/DetailValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
