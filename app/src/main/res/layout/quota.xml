<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/relativeLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <CheckBox
            android:id="@+id/cbUnlimitedData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/unlimited_data"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/cbNoExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/no_expiry"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/textViewQuota"
            style="@style/MetricLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/editTextQuota"
            android:text="@string/Quota" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/editTextQuota"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints="none"
                android:hint="0"
                android:inputType="numberDecimal"
                android:maxLines="1" />
            <Spinner
                android:id="@+id/spinnerUnit"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:entries="@array/entries_dataunits"
                android:paddingStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textViewRepeatFrequency"
            style="@style/MetricLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/editTextRepeatFrequency"
            android:text="@string/Per" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/editTextRepeatFrequency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints="none"
                android:hint="1"
                android:inputType="number"
                android:maxLines="1" />
            <Spinner
                android:id="@+id/spinnerRepeatInterval"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:entries="@array/entries_repeatIntervals"
                android:paddingStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStartDate"
            style="@style/MetricLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/start_date" />

        <Button
            android:id="@+id/pickDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
