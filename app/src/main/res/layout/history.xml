<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linearLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <TextView
        style="@style/ScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history_title" />

    <TextView
        style="@style/SecondaryText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/history_subtitle" />

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:padding="6dp">

        <com.sigterm.views.SegmentedRadioGroup
            android:id="@+id/segment_text"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:checkedButton="@+id/rbCellular"
            android:gravity="center"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbCellular"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="@string/Cellular"
                android:textColor="@color/radio_colors"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbWiFi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="@string/WiFi"
                android:textColor="@color/radio_colors"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbBoth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:gravity="center"
                android:text="@string/Both"
                android:textColor="@color/radio_colors"
                android:textSize="13sp"
                android:textStyle="bold" />
        </com.sigterm.views.SegmentedRadioGroup>
    </LinearLayout>

    <TextView
        android:id="@+id/tvNoItems"
        style="@style/SecondaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/NoHistory" />

    <ListView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:clipToPadding="false"
        android:divider="@color/listDividerColor"
        android:dividerHeight="1dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <include
        android:id="@+id/include1"
        layout="@layout/ad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:clipToPadding="true"
        android:orientation="horizontal"
        android:padding="8dp" />
</LinearLayout>
