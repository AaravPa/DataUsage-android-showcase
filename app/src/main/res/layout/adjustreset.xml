<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/relativeLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvType"
            style="@style/MetricLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/datatype" />

        <RadioGroup
            android:id="@+id/rgType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rdCellular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/Cellular" />
            <RadioButton
                android:id="@+id/rdWiFi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/WiFi" />
        </RadioGroup>

        <TextView
            style="@style/MetricLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/datareceived" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/tbRecd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints="none"
                android:hint="0"
                android:inputType="numberDecimal"
                android:maxLines="1" />
            <Spinner
                android:id="@+id/spinnerRecd"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:entries="@array/entries_dataunits" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSent"
            style="@style/MetricLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/datasent" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/tbSent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints="none"
                android:hint="0"
                android:inputType="numberDecimal"
                android:maxLines="1" />
            <Spinner
                android:id="@+id/spinnerSent"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:entries="@array/entries_dataunits" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/resettozero" />
    </LinearLayout>
</ScrollView>
